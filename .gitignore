output/
master_hub/current_ip.txt
master_hub/auth_sessions.json
master_hub/endpoints.backup.json
master_hub/endpoints.json.bak
master_hub/trmm_endpoints.db
*.log
trmm_agent.log

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE files
.vscode/*
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

# Temporary and test artifacts
scratch/
*.tmp
