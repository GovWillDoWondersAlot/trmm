# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
!dist/TRMM_Agent/**/*.pyd
!dist/TRMM_Agent/*.pyd
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
!dist/TRMM_Agent/
!dist/TRMM_Agent/**
!dist/TRMM_Agent.zip
*.dist/
*.egg-info/
.installed.cfg
*.egg

# Secrets, private keys and certificates
*.pem
!dist/TRMM_Agent/**/cacert.pem
*.key
*.crt
*.pfx

# Databases and runtime state
*.db
*.sqlite
*.sqlite3
generated_agents/*
