<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- App Branding Header -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_launcher"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#f8fafc"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="28dp"
        android:text="Endpoint Security &amp; Management Service"
        android:textColor="#94a3b8"
        android:textSize="13sp" />

    <!-- Protected Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1e293b"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="#10b981" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protected &amp; Active"
                android:textColor="#10b981"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Background service is active and connected."
                android:textColor="#94a3b8"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Remote Screen Mirroring Authorization Section -->
    <LinearLayout
        android:id="@+id/cardProjection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#1e293b"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REMOTE VIEW &amp; SUPPORT"
            android:textColor="#38bdf8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProjectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Screen Mirroring: Standby"
            android:textColor="#94a3b8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRequestProjection"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Authorize Screen Mirroring"
            android:background="#2563eb"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Close / Minimize to Background Button -->
    <Button
        android:id="@+id/btnMinimize"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:text="Close &amp; Keep Running in Background"
        android:background="#334155"
        android:textColor="#f8fafc"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Management service runs securely in the background 24/7."
        android:textColor="#64748b"
        android:textSize="11sp" />

</LinearLayout>
